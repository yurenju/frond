{
  "name": "@yurenju/frond",
  "version": "0.3.0",
  "description": "A TypeScript EPUB rendering library — vertical and horizontal writing, verified across Chromium, Firefox and WebKit",
  "license": "MIT",
  "author": "Yuren Ju <yurenju@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yurenju/frond.git"
  },
  "homepage": "https://yurenju.github.io/frond/",
  "bugs": {
    "url": "https://github.com/yurenju/frond/issues"
  },
  "keywords": [
    "epub",
    "epub3",
    "reader",
    "vertical-writing",
    "cjk",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    "./epub": {
      "types": "./dist/epub/index.d.ts",
      "default": "./dist/epub/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/test-fixtures",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/finish-build.ts",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/generate-fixtures.ts",
    "demo:book": "node scripts/build-demo-book.ts",
    "site": "./scripts/build-site.sh",
    "test:node": "vitest run",
    "test:browser": "playwright test",
    "test:container": "./scripts/test-in-container.sh",
    "evidence": "./scripts/capture-evidence.sh",
    "scan:books": "./scripts/scan-books.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

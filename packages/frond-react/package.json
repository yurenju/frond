{
  "name": "@yurenju/frond-react",
  "version": "0.4.2",
  "description": "Unstyled React components for frond — compose your own EPUB reader, style it entirely with CSS",
  "license": "MIT",
  "author": "Yuren Ju <yurenju@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yurenju/frond.git",
    "directory": "packages/frond-react"
  },
  "homepage": "https://yurenju.github.io/frond/",
  "bugs": {
    "url": "https://github.com/yurenju/frond/issues"
  },
  "keywords": [
    "epub",
    "react",
    "unstyled",
    "headless",
    "reader",
    "vertical-writing",
    "cjk"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/finish-build.ts ."
  },
  "peerDependencies": {
    "@yurenju/frond": "^0.4.2",
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@yurenju/frond": "*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}

{
  // The build configuration for the shipped artifact. The same shape as
  // `packages/frond/tsconfig.build.json`, differing only where the three comments below
  // explain.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,

    // No @types/node. This layer runs in the browser, for the same reason as frond's.
    "types": [],

    // **This setting is the reason this configuration exists.**
    //
    // The root `tsconfig.json` maps `@yurenju/frond/renderer` to frond's **source**, so
    // that an unbuilt tree still typechecks. Cleared, this build goes through real
    // node_modules resolution — that is, `packages/frond/package.json`'s `exports`,
    // pointing at the `.d.ts` emitted into `dist/`.
    //
    // So this build answers, in passing, a question frond cannot answer for itself:
    // **whether the types it ships resolve when imported by another TypeScript project.**
    // frond's tests all go through relative paths and never pass through `exports`; the
    // out-of-repo fake consumer in `release.yml` verifies it, but that only runs on a
    // release. This makes it something verified on every build.
    //
    // The cost is that **frond has to be built first**. The root package.json's `build`
    // therefore hard-codes the order rather than using `--workspaces` (that flag does not
    // guarantee topological order).
    "paths": {}
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

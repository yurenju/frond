node_modules/
test-results/
playwright-report/

# Commercial books stay out of the repo (ADR-0007). Books for verifying locally go here.
tests/books/commercial/

# The one-off specs that produce evidence images for a PR. Each serves a single reading and
# is not a regression test — left in the repo they become something nobody maintains and CI
# still runs (docs/agents/pull-requests.md).
tests/browser/evidence/

# Where those specs write their images. A PR description embeds them from pr-image rather
# than from the repo, so nothing here needs committing; the images a long-lived document
# cites go in docs/evidence/<issue>/ instead (docs/agents/pull-requests.md).
docs/evidence/tmp/

# The shipped artifact. Produced by `npm run build` — committing it would only let it fall
# out of sync with src/.
dist/

# The demo site copies dist/ here at build time (scripts/build-site.sh).
site/frond/

# The synthetic book for the demo. `npm run demo:book` produces it at any time
# (deterministically), and its content and reasoning live in
# src/test-fixtures/demo-book.ts — the artifact need not enter the repo.
tests/books/demo-zh-tw.epub

# Each person's own local Claude Code settings and worktree working directories. The former
# is a personal preference and the latter a temporary checkout — neither should be inherited
# by somebody else's clone.
.claude/settings.local.json
.claude/worktrees/

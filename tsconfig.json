{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],

    // Under src/ and scripts/, everything imports everything else with a .ts extension. The
    // reason is that those files have to be executable by `node` directly (Node's type
    // stripping), and the stripper does not map ./x.js back to ./x.ts — it looks for x.js
    // literally and fails. tests/browser keeps its existing .js notation; bundler resolution
    // accepts both.
    "allowImportingTsExtensions": true

    // **There is deliberately no `paths` here.** There used to be one, mapping
    // `@yurenju/frond/*` onto `src/` so that frond-react could typecheck against an unbuilt
    // tree; with the repo collapsed back to a single package (ADR-0008's revision), nothing
    // inside it reaches frond through a bare specifier any more — every import is relative.
    //
    // The one place that still names the package is `tests/node/epub-book/open.test.ts`,
    // which goes through `exports` **on purpose** and routes the specifier through a variable
    // so tsc gives up resolving it. A mapping here would defeat that test.
    //
    // `tsconfig.build.json` keeps `"paths": {}` regardless — see the comment there.
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    // `site/app.js` and `site/theme.js` are deliberately absent. The home page's whole value
    // is "plain JavaScript, no build step at all", and nothing type-checked imports them, so
    // listing them would check files no other file depends on. They are guarded by
    // `tests/browser/site/demo.spec.ts`, which opens the page for real.
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
